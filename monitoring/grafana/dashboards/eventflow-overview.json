                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            }
        },
        {
            "id": 14,
            "title": "Outbox Backlog Change (10m)",
            "type": "timeseries",
            "gridPos": {
                "x": 12,
                "y": 24,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "eventflow-prometheus"
            },
            "targets": [
                {
                    "expr": "delta(eventflow_outbox_messages{state=\"pending\"}[10m])",
                    "legendFormat": "Net pending change",
