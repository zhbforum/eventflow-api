{
    "id": null,
    "uid": "eventflow-overview",
    "title": "EventFlow Overview",
    "description": "EventFlow API, webhook delivery, transactional outbox and RabbitMQ monitoring.",
    "tags": ["eventflow", "webhooks", "rabbitmq"],
    "timezone": "browser",
    "schemaVersion": 41,
    "version": 1,
    "editable": false,
    "refresh": "15s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "templating": {
        "list": []
    },
    "annotations": {
        "list": []
    },
    "panels": [
        {
            "id": 1,
            "title": "EventFlow API",
            "type": "stat",
            "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
            "datasource": {
                "type": "prometheus",
                "uid": "eventflow-prometheus"
            },
            "targets": [
                {
                    "expr": "up{job=\"eventflow-api\"}",
                    "refId": "A",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": { "text": "DOWN" },
                                "1": { "text": "UP" }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "red", "value": null },
                            { "color": "green", "value": 1 }
                        ]
                    },
                    "color": { "mode": "thresholds" }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none"
            }
        },
        {
            "id": 2,
            "title": "RabbitMQ",
            "type": "stat",
            "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
            "datasource": {
                "type": "prometheus",
                "uid": "eventflow-prometheus"
            },
            "targets": [
                {
                    "expr": "up{job=\"rabbitmq\"}",
                    "refId": "A",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": { "text": "DOWN" },
                                "1": { "text": "UP" }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "red", "value": null },
                            { "color": "green", "value": 1 }
                        ]
                    },
                    "color": { "mode": "thresholds" }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none"
            }
        },
        {
            "id": 3,
            "title": "Pending Webhooks",
            "type": "stat",
            "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
            "datasource": {
                "type": "prometheus",
                "uid": "eventflow-prometheus"
            },
            "targets": [
                {
                    "expr": "eventflow_webhook_deliveries{status=\"pending\"}",
                    "refId": "A",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "value",
                "graphMode": "none"
            }
        },
        {
            "id": 4,
            "title": "Pending Outbox",
            "type": "stat",
            "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
            "datasource": {
                "type": "prometheus",
                "uid": "eventflow-prometheus"
            },
            "targets": [
                {
                    "expr": "eventflow_outbox_messages{state=\"pending\"}",
                    "refId": "A",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "value",
                "graphMode": "none"
            }
        },
        {
            "id": 5,
            "title": "Failed Webhooks",
            "type": "stat",
            "gridPos": { "x": 0, "y": 4, "w": 6, "h": 4 },
            "datasource": {
                "type": "prometheus",
                "uid": "eventflow-prometheus"
            },
            "targets": [
                {
                    "expr": "eventflow_webhook_deliveries{status=\"failed\"}",
                    "refId": "A",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "value",
                "graphMode": "none"
            }
        },
        {
            "id": 6,
            "title": "Webhook Retries",
            "type": "stat",
            "gridPos": { "x": 6, "y": 4, "w": 6, "h": 4 },
            "datasource": {
                "type": "prometheus",
                "uid": "eventflow-prometheus"
            },
            "targets": [
                {
                    "expr": "eventflow_webhook_deliveries_retrying",
                    "refId": "A",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "value",
                "graphMode": "none"
            }
        },
        {
            "id": 7,
            "title": "Outbox Publication Failures",
            "type": "stat",
            "gridPos": { "x": 12, "y": 4, "w": 6, "h": 4 },
            "datasource": {
                "type": "prometheus",
                "uid": "eventflow-prometheus"
            },
            "targets": [
                {
                    "expr": "eventflow_outbox_publish_failures",
                    "refId": "A",
                    "instant": true
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "value",
                "graphMode": "none"
            }
        },
        {
            "id": 8,
            "title": "Oldest Pending Outbox",
            "type": "stat",
            "gridPos": { "x": 18, "y": 4, "w": 6, "h": 4 },
            "datasource": {
                "type": "prometheus",
                "uid": "eventflow-prometheus"
            },
            "targets": [
                {
                    "expr": "eventflow_outbox_oldest_pending_age_seconds",
                    "refId": "A",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "s" },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "value",
                "graphMode": "none"
            }
        },
        {
            "id": 9,
            "title": "Webhook Deliveries by Status",
            "type": "timeseries",
            "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
            "datasource": {
                "type": "prometheus",
                "uid": "eventflow-prometheus"
            },
            "targets": [
                {
                    "expr": "eventflow_webhook_deliveries",
                    "legendFormat": "{{status}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "never"
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            }
        },
        {
            "id": 10,
            "title": "Outbox Messages by State",
            "type": "timeseries",
            "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
            "datasource": {
                "type": "prometheus",
                "uid": "eventflow-prometheus"
            },
            "targets": [
                {
                    "expr": "eventflow_outbox_messages",
                    "legendFormat": "{{state}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "never"
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            }
        },
        {
            "id": 11,
            "title": "RabbitMQ Queue Messages",
            "type": "timeseries",
            "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
            "datasource": {
                "type": "prometheus",
                "uid": "eventflow-prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rabbitmq_queue_messages_ready) or vector(0)",
                    "legendFormat": "Ready",
                    "refId": "A"
                },
                {
                    "expr": "sum(rabbitmq_queue_messages_unacked) or vector(0)",
                    "legendFormat": "Unacknowledged",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "never"
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            }
        },
        {
            "id": 12,
            "title": "Prometheus Scrape Duration",
            "type": "timeseries",
            "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
            "datasource": {
                "type": "prometheus",
                "uid": "eventflow-prometheus"
            },
            "targets": [
                {
                    "expr": "scrape_duration_seconds{job=~\"eventflow-api|rabbitmq\"}",
