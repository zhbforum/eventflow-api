{
    admin off
    auto_https off
}

:8000 {
    root * /app/public

    request_body {
        max_size 2MB
    }

    encode zstd gzip

    php_server {
        try_files {path} index.php
    }

    @phpFile path *.php*
    error @phpFile 404

    log {
        output stdout
        format console
    }
}
